# ── Jira (Atlassian Cloud) ────────────────────────────────────────────────────
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_jira_api_token_here

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Path to your GCP service account key file (JSON)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# The Google Spreadsheet ID that holds the input sheets
# (find it in the URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
GSHEETS_INPUT_SPREADSHEET_ID=your_input_spreadsheet_id_here

# The Google Spreadsheet ID where results are written back
GSHEETS_OUTPUT_SPREADSHEET_ID=your_output_spreadsheet_id_here

# ── DuckDB ────────────────────────────────────────────────────────────────────
# Path to the local DuckDB file (relative to repo root or absolute)
DUCKDB_PATH=data/scrum.duckdb

# ── dbt ───────────────────────────────────────────────────────────────────────
# Rolling window size for velocity average (default: 5 sprints)
DBT_ROLLING_WINDOW_SIZE=5
